{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenerateProblemInternalResponse",
  "type": "object",
  "required": [
    "slug",
    "title",
    "statement_md",
    "input_format_md",
    "output_format_md",
    "constraints_md",
    "target_complexity",
    "sample_cases",
    "subtask_tiers",
    "generator_code",
    "reference_solution_cpp",
    "model_version"
  ],
  "properties": {
    "slug": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "statement_md": { "type": "string", "minLength": 20 },
    "input_format_md": { "type": "string", "minLength": 10 },
    "output_format_md": { "type": "string", "minLength": 5 },
    "constraints_md": { "type": "string", "minLength": 10 },
    "target_complexity": { "type": "string" },
    "sample_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input", "output"],
        "properties": {
          "input": { "type": "string" },
          "output": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "subtask_tiers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["tier", "max_n", "points", "time_limit_ms"],
        "properties": {
          "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
          "max_n": { "type": "integer", "enum": [100, 1000, 10000, 100000] },
          "points": { "type": "integer", "minimum": 1, "maximum": 100 },
          "time_limit_ms": { "type": "integer", "minimum": 500 }
        }
      }
    },
    "generator_code": { "type": "string", "minLength": 20 },
    "reference_solution_cpp": { "type": "string", "minLength": 20 },
    "model_version": { "type": "string" }
  }
}
