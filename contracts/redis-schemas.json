{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlgoBloom Redis Streams Contracts",
  "description": "Canonical message schemas and realistic examples for the 4 Redis Streams used between Core Gateway and Judge Workers via XADD / XREADGROUP / XACK.",
  "transport": {
    "encoding": "UTF-8 JSON serialized under Redis Stream field key `payload`",
    "consumer_groups": {
      "verify_jobs": "cg_verify_workers",
      "verify_results": "cg_gateway_verify_results",
      "judge_jobs": "cg_judge_workers",
      "judge_results": "cg_gateway_judge_results"
    }
  },
  "streams": {
    "verify_jobs": {
      "producer": "services/gateway",
      "consumer": "services/judge-worker (verification mode, /data/problems:rw)",
      "schema": {
        "type": "object",
        "required": [
          "job_id",
          "problem_id",
          "generator_code",
          "reference_solution_cpp",
          "time_limit_ms",
          "memory_limit_mb",
          "subtask_tiers",
          "enqueued_at"
        ],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "problem_id": { "type": "string", "format": "uuid" },
          "generator_code": { "type": "string", "minLength": 1 },
          "reference_solution_cpp": { "type": "string", "minLength": 1 },
          "time_limit_ms": { "type": "integer", "minimum": 500, "maximum": 10000 },
          "memory_limit_mb": { "type": "integer", "minimum": 64, "maximum": 1024 },
          "subtask_tiers": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["tier", "max_n", "points", "time_limit_ms"],
              "properties": {
                "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
                "max_n": { "type": "integer", "enum": [100, 1000, 10000, 100000] },
                "points": { "type": "integer", "minimum": 1, "maximum": 100 },
                "time_limit_ms": { "type": "integer", "minimum": 500 }
              }
            }
          },
          "enqueued_at": { "type": "string", "format": "date-time" }
        }
      },
      "example": {
        "job_id": "55555555-5555-4555-8555-555555555501",
        "problem_id": "33333333-3333-4333-8333-333333333301",
        "generator_code": "import random, sys\nn = int(sys.argv[1])\nseed = int(sys.argv[2])\nrng = random.Random(seed)\nprint(n)\nprint(' '.join(str(rng.randint(1, 10**9)) for _ in range(n)))\n",
        "reference_solution_cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);int n;cin>>n;vector<int> t;for(int i=0;i<n;i++){int x;cin>>x;auto it=lower_bound(t.begin(),t.end(),x);if(it==t.end())t.push_back(x);else *it=x;}cout<<t.size()<<'\\n';}\n",
        "time_limit_ms": 2000,
        "memory_limit_mb": 256,
        "subtask_tiers": [
          { "tier": 1, "max_n": 100, "points": 25, "time_limit_ms": 2000 },
          { "tier": 2, "max_n": 1000, "points": 25, "time_limit_ms": 2000 },
          { "tier": 3, "max_n": 10000, "points": 25, "time_limit_ms": 2000 },
          { "tier": 4, "max_n": 100000, "points": 25, "time_limit_ms": 2000 }
        ],
        "enqueued_at": "2026-11-24T08:30:05Z"
      }
    },
    "verify_results": {
      "producer": "services/judge-worker (verification mode)",
      "consumer": "services/gateway",
      "schema": {
        "type": "object",
        "required": [
          "job_id",
          "problem_id",
          "verified",
          "storage_path",
          "subtask_benchmarks",
          "completed_at"
        ],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "problem_id": { "type": "string", "format": "uuid" },
          "verified": { "type": "boolean" },
          "storage_path": { "type": "string" },
          "subtask_benchmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["tier", "max_n", "status", "time_ms", "memory_kb", "test_count"],
              "properties": {
                "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
                "max_n": { "type": "integer" },
                "status": { "type": "string", "enum": ["AC", "WA", "TLE", "MLE", "RE", "CE", "IE"] },
                "time_ms": { "type": "integer", "minimum": 0 },
                "memory_kb": { "type": "integer", "minimum": 0 },
                "test_count": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "error_code": { "type": ["string", "null"] },
          "error_message": { "type": ["string", "null"] },
          "completed_at": { "type": "string", "format": "date-time" }
        }
      },
      "example": {
        "job_id": "55555555-5555-4555-8555-555555555501",
        "problem_id": "33333333-3333-4333-8333-333333333301",
