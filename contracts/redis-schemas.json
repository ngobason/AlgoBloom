        "submission_id": "44444444-4444-4444-8444-444444444401",
        "problem_id": "33333333-3333-4333-8333-333333333301",
        "storage_path": "/data/problems/33333333-3333-4333-8333-333333333301",
        "language": "cpp20",
        "source_code": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n;cin>>n;vector<int> a(n),dp(n,1);for(int i=0;i<n;i++)cin>>a[i];int ans=0;for(int i=0;i<n;i++){for(int j=0;j<i;j++)if(a[j]<a[i])dp[i]=max(dp[i],dp[j]+1);ans=max(ans,dp[i]);}cout<<ans<<'\\n';}\n",
        "time_limit_ms": 2000,
        "memory_limit_mb": 256,
        "subtask_tiers": [
          { "tier": 1, "max_n": 100, "points": 25, "time_limit_ms": 2000 },
