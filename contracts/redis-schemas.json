          { "tier": 4, "max_n": 100000, "status": "AC", "time_ms": 38, "memory_kb": 5120, "test_count": 5 }
        ],
        "error_code": null,
        "error_message": null,
        "completed_at": "2026-11-24T08:31:12Z"
      }
    },
    "judge_jobs": {
      "producer": "services/gateway",
      "consumer": "services/judge-worker (judging mode, /data/problems:ro)",
      "schema": {
        "type": "object",
        "required": [
          "job_id",
          "submission_id",
          "problem_id",
          "storage_path",
          "language",
          "source_code",
          "time_limit_ms",
          "memory_limit_mb",
          "subtask_tiers",
          "enqueued_at"
        ],
        "properties": {
          "job_id": { "type": "string", "format": "uuid" },
          "submission_id": { "type": "string", "format": "uuid" },
          "problem_id": { "type": "string", "format": "uuid" },
          "storage_path": { "type": "string" },
          "language": { "type": "string", "enum": ["cpp17", "cpp20", "python3"] },
          "source_code": { "type": "string", "minLength": 1 },
          "time_limit_ms": { "type": "integer", "minimum": 500 },
          "memory_limit_mb": { "type": "integer", "minimum": 64 },
          "subtask_tiers": {
